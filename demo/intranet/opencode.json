{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["internal-vllm"],
  "model": "internal-vllm/MiniMaxAI/MiniMax-M2.5",
  "small_model": "internal-vllm/MiniMaxAI/MiniMax-M2.5",
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "internal-vllm": {
      "name": "Internal vLLM",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://10.90.79.111:8000/v1",
      "env": [],
      "options": {
        "baseURL": "http://10.90.79.111:8000/v1",
        "apiKey": "internal"
      },
      "models": {
        "MiniMaxAI/MiniMax-M2.5": {
          "name": "MiniMax M2.5",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "limit": {
            "context": 196608,
            "output": 128000
          }
        }
      }
    }
  },
  "security": {
    "safe_mode": true,
    "allowed_hosts": ["10.90.79.111:8000"],
    "disable_dynamic_installs": true,
    "disable_remote_instructions": true,
    "disable_remote_mcp": true
  }
}
