{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["internal-vllm"],
  "model": "internal-vllm/hiq-llm",
  "small_model": "internal-vllm/hiq-llm",
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "internal-vllm": {
      "name": "Internal vLLM",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://__OPENCODE_INTRANET_HOST__:4000/v1",
      "env": [],
      "options": {
        "baseURL": "http://__OPENCODE_INTRANET_HOST__:4000/v1",
        "apiKey": "__OPENCODE_INTRANET_API_KEY__"
      },
      "models": {
        "hiq-llm": {
          "name": "hiq-llm",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 262144
          }
        }
      }
    }
  },
  "instructions": ["uv-python.md"],
  "security": {
    "safe_mode": true,
    "allowed_hosts": ["__OPENCODE_INTRANET_HOST__:4000"],
    "disable_dynamic_installs": true,
    "disable_remote_instructions": true,
    "disable_remote_mcp": true
  }
}
